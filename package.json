{
  "name": "printshop-discord-bot",
  "version": "0.1.0",
  "description": "Small Discord bot: posts announcements in one channel and reports who reacted 👍 to them. Used by printshop-scheduler for print requests.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imeckler/printshop-discord-bot.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
